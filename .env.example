# ---------------------------------------------------------------------------
# windowsill configuration
#
# Copy to `.env` in the working directory (or point at it with --config).
# Every value below is optional; the defaults shown are what the tool uses.
# ---------------------------------------------------------------------------

# --- Window model ----------------------------------------------------------
# Length of the rolling usage window, in hours. Anthropic's session window is
# 5 hours. Only change this if you know the plan you are on differs.
SILL_WINDOW_HOURS=5

# How often to poll the official usage endpoint, in seconds.
# The endpoint is cheap, but be a good citizen: 60s is plenty.
SILL_POLL_INTERVAL=60

# Tick rate, in seconds. This drives the live countdown, the menu bar / tray
# title, the live.json feed the GUIs read, and the moment threshold alerts
# fire - all without touching the network. 1 = a real per-second clock.
SILL_UI_REFRESH=1

# --- Data sources ----------------------------------------------------------
# Ordered, comma-separated. The first source that yields a usable snapshot
# wins; the rest are fallbacks. Valid values: oauth, statusline, local
#   oauth      - official https://api.anthropic.com/api/oauth/usage endpoint
#   statusline - JSON written by the Claude Code statusLine hook (see README)
#   local      - purely local timer, inferred from observed activity
SILL_SOURCES=oauth,statusline,local

# Path the statusline hook writes its snapshot to.
# Defaults to <state-dir>/statusline.json
# SILL_STATUSLINE_FILE=

# --- Authentication --------------------------------------------------------
# Normally left blank: the tool reads the credentials Claude Code already
# stores (macOS Keychain, or ~/.claude/.credentials.json on Windows/Linux).
# Set this only to override with an explicit OAuth access token.
# SILL_OAUTH_TOKEN=

# If the stored access token has expired, refresh it in-process using the
# stored refresh token and write the result back to the credential store.
# Default false: the safer path is to let Claude Code manage its own tokens.
# The auto-reset shell-out runs `claude` every ~5h, which refreshes them for us.
SILL_ALLOW_TOKEN_REFRESH=false

# --- Automatic session re-arming ------------------------------------------
# After the window resets, send a tiny prompt so the next window starts (and
# so its true server-side reset time becomes observable).
SILL_AUTO_TRIGGER=true

# The prompt to send. Keep it small - it is billed against the new window.
SILL_TRIGGER_PROMPT=Hi

# Command used to send it. `{prompt}` is substituted.
# Must be a non-interactive, official Claude Code invocation.
SILL_TRIGGER_COMMAND=claude -p {prompt} --output-format json

# Model to use for the trigger message. Cheapest is best.
SILL_TRIGGER_MODEL=claude-haiku-4-5-20251001

# Seconds to wait after the window resets before firing the trigger. A small
# delay avoids racing the server-side reset.
SILL_TRIGGER_DELAY=15

# Seconds before the trigger subprocess is killed.
SILL_TRIGGER_TIMEOUT=120

# How many times to retry a failed trigger, with exponential backoff.
SILL_TRIGGER_MAX_RETRIES=5

# --- Menu bar / tray -------------------------------------------------------
# true  -> a real per-second clock in the macOS menu bar:  ● 4:12:37
# false -> compact, two characters shorter, changes once a minute above an
#          hour, which crowds your other menu bar items less:  ● 4h12m
# Either way the dropdown and the detail window always tick every second.
SILL_MENUBAR_SECONDS=true

# Panel appearance: dark (default), light, or auto to follow the OS.
SILL_THEME=dark

# --- Notifications ---------------------------------------------------------
# Minutes-remaining thresholds that fire a notification. Comma-separated.
SILL_ALERT_THRESHOLDS=30,10,5

# Native OS notification (macOS Notification Center / Windows toast).
SILL_DESKTOP_NOTIFICATIONS=true

# Generic webhook. Receives a JSON POST for every notification event.
# SILL_WEBHOOK_URL=

# Discord incoming webhook.
# SILL_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Slack incoming webhook.
# SILL_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Seconds to wait on any webhook call.
SILL_WEBHOOK_TIMEOUT=10

# --- Logging & state -------------------------------------------------------
# Directory for logs, the event ledger, persisted state, and the live.json
# snapshot the menu bar / tray front-ends read.
# Defaults to ~/.windowsill
# SILL_STATE_DIR=

# TRACE, DEBUG, INFO, WARNING, ERROR
SILL_LOG_LEVEL=INFO

# Emit logs as JSON lines instead of human-readable text.
SILL_LOG_JSON=false

# Rotating log file settings.
SILL_LOG_MAX_BYTES=5242880
SILL_LOG_BACKUP_COUNT=5

# --- Resilience ------------------------------------------------------------
# Wall-clock jump (seconds) that counts as a system sleep/resume, forcing an
# immediate re-sync rather than trusting the elapsed timer.
SILL_CLOCK_JUMP_THRESHOLD=90

# Backoff bounds for network failures, in seconds.
SILL_BACKOFF_MIN=5
SILL_BACKOFF_MAX=300
